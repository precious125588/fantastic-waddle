    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "jimp": "^0.22.12",
    "awesome-phonenumber": "^2.64.0",
    "moment-timezone": "^0.5.45",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.1",
    "yt-search": "^2.13.1"
  },
  "optionalDependencies": {
