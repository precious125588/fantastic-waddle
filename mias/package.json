  "description": "MIAS MDX Bot — powered by @itsliaaa/baileys (aliased as @whiskeysockets/baileys)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=896 index.js",
