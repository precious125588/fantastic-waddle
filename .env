# ─────── MAIS MDX WEB PAIRING ───────
# Copy this to .env and fill in your values

# Port: Railway sets this AUTOMATICALLY — do NOT set PORT manually on Railway
# PORT=3000

# ── SESSION PERSISTENCE (Railway) ────────────────────────────────────────────
# Your volume is mounted at /app/nexstore. Sessions MUST be written inside it,
# otherwise every deploy wipes them and you have to pair again.
# Leave this line as-is if your volume is mounted at /app/nexstore.
SESSION_DIR=/app/nexstore/pairing

# Do not give up reconnecting a live session after N auto-restarts
MAX_AUTO_RESTARTS=999
MAX_INSTANCES=50

# Admin panel credentials (CHANGE THE PASSWORD!)
ADMIN_PASSWORD=your_080205
ADMIN_USERNAME=admin

# Bot branding
BOT_NAME=MAIS MDX
PREFIX=.

# Owner WhatsApp number (digits only, no +)
OWNER_NUMBER=2349068551055

# MAIS MDX runtime
MARK_ONLINE=1
LOG_DEDUP=1

# Telegram bot token (required for Telegram pairing)
TELEGRAM_BOT_TOKEN=8667878961:AAENPLkdCFlpUTBmNzoPaN9m2mFzBNNI6zM

# Telegram admin IDs (comma-separated)
ADMIN_IDS=6633606776

# Required channels/groups users must join before pairing
REQUIRED_GROUP=https://t.me/crasherpp
REQUIRED_CHANNELS=https://t.me/crasherpp

# Zero API key
ZERO_API_KEY=

# Social / Telegram channel links (override these with your own)
TG_CHANNEL_1=https://t.me/crasherpp
TG_CHANNEL_2=https://t.me/crasherpp
TG_CHANNEL_3=https://t.me/crasherpp
TG_CHANNEL_4=https://t.me/crasherpp
