# ─────── MAIS MDX WEB PAIRING ───────
# Copy this to .env and fill in your values

# Port: Railway sets this AUTOMATICALLY — do NOT set PORT manually on Railway
# PORT=3000

# Admin panel credentials (CHANGE THE PASSWORD!)
ADMIN_PASSWORD=your_strong_password_here
ADMIN_USERNAME=admin

# Bot branding
BOT_NAME=MAIS MDX
PREFIX=.

# Owner WhatsApp number (digits only, no +)
OWNER_NUMBER=

# MAIS MDX runtime
MARK_ONLINE=1
LOG_DEDUP=1
MAX_INSTANCES=

# Telegram bot token (required for Telegram pairing)
TELEGRAM_BOT_TOKEN=8823220070:AAGVKW7Yv0X2cCPGIxytaz0WDvUiU9qDxmI

# Telegram admin IDs (comma-separated)
ADMIN_IDS=6633606776

# Required channels/groups users must join before pairing
REQUIRED_GROUP=https://t.me/crasherpp
REQUIRED_CHANNELS=

# Zero API key
ZERO_API_KEY=ZERO-ADMIN-4e8a479a618e7a43d0a4edd1
