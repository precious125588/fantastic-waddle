# ─────── MAIS MDX WEB PAIRING ───────
# Copy this to .env and fill in your values

# Port: Railway sets this AUTOMATICALLY — do NOT set PORT manually on Railway
# PORT=3000

# Admin panel credentials (CHANGE THE PASSWORD!)
ADMIN_PASSWORD=your_strong_password_here
ADMIN_USERNAME=admin

# Bot branding
BOT_NAME=MAIS MDX
PREFIX=.

# Owner WhatsApp number (digits only, no +)
OWNER_NUMBER=

# MAIS MDX runtime
MARK_ONLINE=1
LOG_DEDUP=1
MAX_INSTANCES=20

# Telegram bot token (required for Telegram pairing)
TELEGRAM_BOT_TOKEN=

# Telegram admin IDs (comma-separated)
ADMIN_IDS=

# Required channels/groups users must join before pairing
REQUIRED_GROUP=
REQUIRED_CHANNELS=

# Zero API key
ZERO_API_KEY=

# Social / Telegram channel links (override these with your own)
TG_CHANNEL_1=https://t.me/crasherpp
TG_CHANNEL_2=https://t.me/crasherpp
TG_CHANNEL_3=https://t.me/crasherpp
TG_CHANNEL_4=https://t.me/crasherpp
TG_GROUP_1=https://t.me/crasherpp
WHATSAPP_LINK=
DEVELOPER_LINK=https://t.me/crasherpp
FALLBACK_LINK=https://t.me/crasherpp
